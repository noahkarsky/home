# Defaults for running Home Information locally, shared by scripts/hi-dev.sh
# and scripts/home-launcher.ps1. A variable already set in the environment
# wins. @ROOT@ is the repo root; @DATA@ is $HI_DATA_DIR (default @ROOT@/.data/hi).
DJANGO_SETTINGS_MODULE=hi.settings.development
DJANGO_SECRET_KEY=django-insecure-local-dev-only
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin
HI_DB_PATH=@DATA@/database
HI_MEDIA_PATH=@DATA@/media
HI_REDIS_HOST=localhost
HI_REDIS_PORT=6379
HI_SUPPRESS_AUTHENTICATION=true
HI_FLOORPLAN3D_HTML=@ROOT@/apps/floorplan-3d/index.html
